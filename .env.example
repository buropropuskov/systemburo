# =============================================================
# Systemburo — переменные окружения
# Скопируйте в .env и измените значения под своё окружение
# =============================================================

# === База данных ===
DB_NAME=auto_registry
DB_USER=postgres
DB_PASSWORD=dev-password-change-me
DATABASE_URL=postgres://postgres:dev-password-change-me@db/auto_registry

# === Go Backend ===
BIND_HOST=0.0.0.0
BIND_PORT=8080
LOG_LEVEL=info
# Включить Swagger UI на /swagger/index.html (только для dev/staging, НЕ для production)
SWAGGER_ENABLED=true

# === JWT (минимум 32 символа каждый!) ===
JWT_SECRET=change-me-in-production-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
# TTL токенов. Access короткий (клиент рефрешит автоматически), refresh длинный.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# === CORS ===
CORS_ALLOWED_ORIGINS=http://localhost:8081

# === Загрузка файлов ===
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_ALLOWED_DOC_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document
UPLOAD_PATH=./uploads

# === Файловый архив бланков ===
# Каталог на хосте, куда складываются заполненные бланки заявок. Обязан лежать ВНЕ
# UPLOAD_PATH: загрузки раздаются без авторизации, а в бланках персональные данные.
# Приложение не запустится, если каталоги вложены друг в друга.
# На проде - отдельный раздел, желательно зашифрованный (см. docs/DEPLOYMENT.md).
ARCHIVE_HOST_PATH=./archive
# Каталог на хосте под пакеты выгрузки по идентификатору сущности (server entity
# export). Требования те же, что у архива, и по той же причине: в пакете лежат
# персональные данные организации целиком, поэтому каталог обязан быть вне
# UPLOAD_PATH, иначе приложение не запустится. Пакет забирают с сервера руками,
# внутри контейнера он не пережил бы его пересоздания.
ENTITY_EXPORT_HOST_PATH=./entity-export
# Как часто разбирается очередь выгрузки и как часто подметаются пропуски.
ARCHIVE_WORKER_TICK=15s
ARCHIVE_SWEEP_INTERVAL=5m
# Шифрование бланков на диске. Открытая часть - ключ той стороны, которая их
# читает; закрытая нужна системе, чтобы отдавать бланки по кнопке в карточке
# заявки. Заполнять обе или ни одной. Пара ключей: age-keygen.
# При REQUIRE_ENCRYPTION=true пустые строки не дадут серверу стартовать.
ARCHIVE_AGE_RECIPIENT=
ARCHIVE_AGE_IDENTITY=

# === Шифрование ПД (152-ФЗ) ===
# 32 байта в hex (64 символа). Сгенерировать: openssl rand -hex 32
DATA_ENCRYPTION_KEY=
REQUIRE_ENCRYPTION=false

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=200
RATE_LIMIT_WINDOW_SEC=60

# === Pagination ===
PAGINATION_MAX_LIMIT=100

# === pgAdmin (dev/staging) ===
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# === Basic Auth (staging) ===
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=changeme

# === Telegram bug-report ===
# Бот и чат, куда улетают 500-репорты со страницы Error500.
# Если пустые - репорты пишутся только в БД без отправки в TG.
# Создать бота: @BotFather -> /newbot
# Получить chat_id: добавить бота в канал/группу и отправить "curl https://api.telegram.org/bot<TOKEN>/getUpdates"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Frontend ===
VITE_API_BASE_URL=http://localhost:8080

# === Резервное копирование ===
# Каталог копий на сервере. Права ставит scripts/backup-install.sh: 700, а с
# группой оператора ниже - 710.
BACKUP_DIR=/var/backups/systemburo
# Группа учётной записи оператора: он контролирует копирование, не получая доступа
# к копиям. Каталогу даётся только проход для неё - status.json и backup.log
# читаются без sudo, сами копии и их перечень остаются закрытыми. Такой группы на
# сервере нет - каталог закрыт целиком. Пусто - оператору не открывается ничего.
BACKUP_OPERATOR_GROUP=buro
# Открытый ключ age, которым шифруются копии. Закрытый ключ хранится ОТДЕЛЬНО от
# копий (в хранилище секретов организации) - иначе кража архива равносильна краже
# персональных данных. Пара ключей: age-keygen -o buro-backup.key
# Пусто - копирование останавливается с ошибкой и не создаёт копию вовсе.
BACKUP_AGE_RECIPIENT=
# Разрешение снимать копии без шифрования. Единственное значение, которое
# принимается, - yes. Осознанный отказ от шифрования: копия будет создана, но
# скрипт громко предупредит, а в состоянии останется отметка encrypted: false.
BACKUP_ALLOW_UNENCRYPTED=
# Сроки хранения: суточные, недельные (воскресенье), месячные (первое число).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Как часто архивировать загруженные файлы: weekly или daily. База выгружается
# ежедневно в любом случае; файлы весят больше и по умолчанию идут раз в неделю.
BACKUP_UPLOADS_MODE=weekly
# Выгрузка копий вне сервера через rclone. Пусто - копии остаются на сервере,
# и это единственная точка отказа, о чём скрипт пишет в журнал.
BACKUP_S3_REMOTE=
BACKUP_S3_BUCKET=

# --- Почтовая рассылка (#1906) ---
# Система не поднимает свой почтовый сервер, а подключается клиентом к чужому:
# Джино (smtp.jino.ru), Яндекс 360 (smtp.yandex.ru) или сервер организации.
# Пустой SMTP_HOST - почта выключена: письма не отправляются, а плановая смена
# паролей отказывается запускаться, вместо того чтобы менять пароли в пустоту.
SMTP_HOST=
# 587 при SMTP_TLS_MODE=starttls, 465 при tls.
SMTP_PORT=587
# Логин обычно совпадает с полным адресом ящика. У Яндекса нужен пароль
# приложения, а не пароль от учётной записи.
SMTP_USERNAME=
SMTP_PASSWORD=
# Адрес отправителя обязан совпадать с ящиком, под которым система входит на
# сервер: иначе письма отвергаются с ошибкой 550.
SMTP_FROM=
# Кавычки обязательны: значение с пробелом без них ломает чтение файла через
# `. ./.env`, а так его читают сценарии копирования (backup.sh, backup-status.sh).
SMTP_FROM_NAME="Бюро пропусков"
# starttls (587), tls (465) или none - последнее только для сервера в закрытом
# контуре, где шифрование обеспечивает сама сеть.
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SEC=15
# Потолок отправки, заведомо ниже лимита провайдера (у Джино 500 писем в час).
SMTP_RATE_PER_HOUR=400
# Сколько раз пытаться доставить письмо, прежде чем позвать администратора.
MAIL_RETRY_ATTEMPTS=5
# Как часто разбирается очередь писем.
MAIL_WORKER_TICK=15s

# --- Проверка живости системы ---
# Читается сценарием scripts/health-check.sh, в приложение не передаётся. Ставится
# на расписание один раз: sudo ./scripts/health-install.sh production 5
#
# Внешний адрес системы - тот же, по которому её открывает человек, а не
# localhost: иначе проверка не увидит ни просроченный сертификат, ни упавший
# nginx. Пусто - проверка останавливается с ошибкой и говорит, чего ей не хватает.
HEALTH_CHECK_URL=
# Учётная запись, которой проверка входит в систему. Заводится отдельная, обычным
# пользователем без прав администратора и без заявок: её единственное дело -
# доказывать, что вход работает. Пусто - вход не проверяется, и проверка каждый
# раз пишет об этом в журнал: без входа она вырождается в ту же ручку /health,
# которая отвечает "ok" при отвалившейся базе.
#
# Пароль этой учётной записи живёт здесь в открытом виде, как и пароль почты
# ниже. Если в организации принята плановая смена паролей, менять его надо
# одновременно здесь и в системе - иначе проверка объявит отказ на исправной
# системе.
HEALTH_CHECK_USERNAME=
HEALTH_CHECK_PASSWORD=
# Базовая авторизация nginx, если адрес закрыт ею (стенд). Вида "логин:пароль".
# На закрытом адресе проверка не выходит из системы после входа: базовая
# авторизация и токен делят один заголовок.
HEALTH_CHECK_BASIC_AUTH=
# Кому писать об отказе. Несколько адресов - через запятую. Кавычки обязательны,
# если внутри есть пробел: без них строка ломает чтение файла через `. ./.env`.
# Пусто - письма не отправляются, итог остаётся только в журнале проверки.
HEALTH_ALERT_TO=
# Как часто напоминать, пока отказ длится. Письмо приходит на смене состояния
# (упало, поднялось) в любом случае; это - только про напоминания. 0 отключает их.
HEALTH_ALERT_REPEAT_MIN=60
# Куда класть журнал и файл состояния. Каталог закрыт (700): в нём внешний адрес
# системы и имя проверяющей учётной записи. Состояние лежит файлом, а не в базе,
# намеренно - база одно из того, что проверяется, и в аварию была бы недоступна.
HEALTH_STATE_DIR=/var/lib/systemburo/health
# Сколько ждать ответа от системы и от почтового сервера.
HEALTH_TIMEOUT_SEC=20
# Проверять ли базу напрямую: auto - только если стек описан на этой машине,
# on - всегда, off - никогда. Прямая проба нужна для разбора: вход упал при живой
# базе и вход упал вместе с базой - разные аварии.
HEALTH_CHECK_DB=auto
