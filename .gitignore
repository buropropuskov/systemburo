*.tmp
mockup-*.html
# Отладочные снимки экрана в корне: копятся десятками при ручной проверке вёрстки.
# Ограничено корнем - изображения фронтенда лежат во frontend/public и нужны сборке.
/*.png

# Runtime-загрузки (тестовые/локальные артефакты, не хранятся в VCS)
internal/handlers/uploads/

# Файловый архив бланков при локальном запуске (ARCHIVE_HOST_PATH по умолчанию).
# Содержит персональные данные и в VCS не попадает никогда.
/archive/

# Отчёт локального прогона сканера секретов
gitleaks.log
