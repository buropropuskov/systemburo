@startuml
' Блок-схема обработки заявки на ремонт по ГОСТ 19.701-90
' (PlantUML activity diagram с настройкой под ГОСТ-формы)
skinparam handwritten false
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName Times New Roman
skinparam defaultFontSize 13

skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #000000
skinparam ActivityBorderThickness 1.4
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #000000
skinparam ActivityDiamondBorderThickness 1.4
skinparam ActivityStartColor #000000
skinparam ActivityEndColor #000000
skinparam ActivityArrowColor #000000
skinparam ArrowColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000

start
:Оператор обнаруживает
неисправность оборудования;
:<<input>> Регистрация заявки:
выбор оборудования, описание,
приоритет;
:Инженер ОГМ просматривает
заявку, оценивает приоритет;
:Назначение исполнителя (техника);
:Техник принимает заявку в работу;

if (Запчасти доступны на складе?) then (да)
else (нет)
  :Формирование заказа запчастей;
  :Ожидание поступления на склад;
endif

:Выполнение ремонтных работ;
:<<output>> Фиксация результатов:
работы, запчасти, время;

if (Качество работ приёмлемо?) then (да)
  :Закрытие заявки (статус «Закрыта»);
  stop
else (нет)
  :Доработка по замечаниям;
  detach
endif
@enduml
